# Flask Security (Replace with a random 32+ character string in your actual .env)
SECRET_KEY=your_super_secret_flask_key_here

# Database (Update with your actual local or Docker credentials in your actual .env)
DATABASE_URL=postgresql://postgres:postgre123@localhost:5432/interview_system

# AI & RAG
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Email (Use a Gmail App Password, NOT your regular password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password
MAIL_ENABLED=True

# Frontend URL (For CORS)
FRONTEND_URL=http://localhost:5173